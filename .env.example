# =========================
# Qdrant
# =========================

QDRANT_URL=https://your-qdrant-url
QDRANT_API_KEY=your-qdrant-api-key

# =========================
# PostgreSQL
# =========================

# Local development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/northstar

# Test database (pytest)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/northstar_test

# Alembic migrations
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/northstar

# Docker service-to-service examples
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/northstar
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres_test:5432/northstar_test

# =========================
# Redis
# =========================

REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://redis:6379/0 # Docker service-to-service

# =========================
# LLM
# =========================

OPENAI_API_KEY=your-openai-api-key
USE_LOCAL_LLM=False

# =========================
# Application
# =========================

# Generate a dummy password hash using (pick your own dummy string):
# from app.core.security import password_hasher
# print(password_hasher.hash("Yourdummypasswordstring"))
DUMMY_PASSWORD_HASH=$argon2id$Somerandompasswordhash

# Gen using e.g. python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret

# Cookie settings
COOKIE_SECURE=false # use false for dev (allow sending cookie over both http and https), use true for prod (only https)

# =========================
# RAG - Embeddings
# =========================

# Supported providers:
# - local
# - voyage
EMBEDDING_PROVIDER=local

# Used when EMBEDDING_PROVIDER=local
# Default: BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Used when EMBEDDING_PROVIDER=voyage
# Recommended default: voyage-4-lite
VOYAGE_EMBEDDING_MODEL=voyage-4-lite
VOYAGE_EMBEDDING_BATCH_SIZE=8  # Set to e.g. 64 on paid
VOYAGE_EMBEDDING_SLEEP_SECONDS=25  # Set to e.g. 0 on paid
VOYAGE_API_KEY=

# =========================
# RAG - Reranking
# =========================

# Supported providers:
# - local
# - cohere
RERANKER_PROVIDER=local

# Used when RERANKER_PROVIDER=local
# Default: BAAI/bge-reranker-v2-m3
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Used when RERANKER_PROVIDER=cohere
# Recommended default (English-only): rerank-english-v3.0
COHERE_RERANKER_MODEL=rerank-english-v3.0
COHERE_API_KEY=