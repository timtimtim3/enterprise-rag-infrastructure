# =========================
# Qdrant
# =========================

QDRANT_URL=https://your-qdrant-url
QDRANT_API_KEY=your-qdrant-api-key

# =========================
# PostgreSQL
# =========================

# Local development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/northstar

# Test database (pytest)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/northstar_test

# Alembic migrations
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/northstar

# Docker service-to-service examples
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/northstar
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres_test:5432/northstar_test

# =========================
# Redis
# =========================

REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://redis:6379/0 # Docker service-to-service

# =========================
# LLM
# =========================

OPENAI_API_KEY=your-openai-api-key
USE_LOCAL_LLM=False

# =========================
# Application
# =========================

# Generate a dummy password hash using (pick your own dummy string):
# from app.core.security import password_hasher
# print(password_hasher.hash("Yourdummypasswordstring"))
DUMMY_PASSWORD_HASH=$argon2id$Somerandompasswordhash

# Gen using e.g. python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret
